# Copy to .env and adjust. Every value has a working default; .env is optional.

# Where imported sessions and the catalog live (relative to the working directory or absolute).
SENSEBENCH_DATA_DIR=data

# The server binds to localhost by default so team data never leaves the machine.
# Use 0.0.0.0 only inside a container or if you deliberately want LAN access.
SENSEBENCH_HOST=127.0.0.1
SENSEBENCH_PORT=8000

# Optional Neo4j profile (`docker compose --profile graph up`). Password must be at least 8 characters.
NEO4J_AUTH=neo4j/change-me-please
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
